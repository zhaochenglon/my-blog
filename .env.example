# 复制为 .env 后使用：copy .env.example .env
MYSQL_ROOT_PASSWORD=blog_dev_password
# CD 部署时填写 ACR 镜像（例：registry.cn-hangzhou.aliyuncs.com/命名空间/blog-api:latest）
# BLOG_API_IMAGE=registry.cn-hangzhou.aliyuncs.com/your-namespace/blog-api:latest
# 主从复制账号（仅 docker-compose.replica.yml / init-master 使用）
MYSQL_REPLICATION_PASSWORD=repl_dev_password
